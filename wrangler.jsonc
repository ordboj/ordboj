{
  // Pages project for the Ordböj SPA and the auth Functions.
  // A production deploy reads env.production.
  // A preview deploy reads env.preview.
  // d1_databases is not inherited, so each named environment repeats it.
  // Pages does not use preview_database_id for a preview deploy.
  // pages_build_output_dir stays ./dist so the SPA deploy is unchanged.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordboj",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ordboj-auth",
      "database_id": "ebdb1667-044a-430b-8412-c8b03da1f229",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ordboj-auth",
          "database_id": "ebdb1667-044a-430b-8412-c8b03da1f229",
          "migrations_dir": "migrations",
        },
      ],
    },
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ordboj-auth-preview",
          "database_id": "ba9a4066-b4e4-4058-885d-a20fae74d05d",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
