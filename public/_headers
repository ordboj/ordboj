/assets/*
  Cache-Control: public, max-age=31536000, immutable

# frame-ancestors is a CSP directive that browsers ignore in <meta
# http-equiv> (see index.html); it only takes effect as an HTTP response
# header, hence it lives here instead of the meta CSP. X-Frame-Options is
# the legacy fallback for browsers that predate frame-ancestors support.
# Ref: issue #223.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
