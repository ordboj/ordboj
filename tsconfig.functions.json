{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["functions/**/*.ts", "scripts/generate-auth-migration.ts"]
}
