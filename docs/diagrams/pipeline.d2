style: {fill: "#FFFFFF"}

direction: down

classes: {
  human: {
    shape: c4-person
    style: {
      fill: "#FEF3C7"
      stroke: "#D97706"
      font-color: "#78350F"
      border-radius: 8
    }
  }
  agent: {
    shape: c4-person
    style: {
      fill: "#DBEAFE"
      stroke: "#3B82F6"
      font-color: "#1E3A8A"
      border-radius: 8
    }
  }
  critic: {
    shape: c4-person
    style: {
      fill: "#FCE7F3"
      stroke: "#DB2777"
      font-color: "#831843"
      border-radius: 8
    }
  }
  step: {
    style: {
      fill: "#F1F5F9"
      stroke: "#94A3B8"
      font-color: "#334155"
      border-radius: 6
    }
  }
  good: {
    style: {
      fill: "#DCFCE7"
      stroke: "#16A34A"
      font-color: "#14532D"
      border-radius: 20
    }
  }
  bad: {
    style: {
      fill: "#E2E8F0"
      stroke: "#64748B"
      font-color: "#334155"
      border-radius: 20
    }
  }
}

human: "Human" {
  class: human
  width: 200
  height: 170
}

ip: "1 · idea-pilot — is it worth building?" {
  style: {fill: "#F8FAFC"; stroke: "#CBD5E1"; font-color: "#334155"; border-radius: 8}
  review: "blind value review" {
    style: {fill: "#EFF6FF"; stroke: "#93C5FD"; font-color: "#1E3A8A"; border-radius: 8}
    grid-columns: 2
    grid-gap: 24
    srs: "srs-engine" {class: agent}
    swe: "swedish-linguist" {class: agent}
    led: "learning-designer" {class: agent}
    uxp: "ui-ux-expert" {class: agent}
  }
  debate: "design-critic\n\nattacks weak arguments" {class: critic}
  verdict: "Verdict" {
    shape: diamond
    style: {fill: "#FCE7F3"; stroke: "#DB2777"; font-color: "#831843"}
  }
  tickets: "staff-engineer\n\ncuts parallel-safe tickets" {class: agent}

  review -> debate
  debate -> review: "contested,\none rebuttal round" {style: {stroke: "#DB2777"; font-color: "#831843"; stroke-dash: 3}}
  debate -> verdict
  verdict -> tickets: pursue
}

tp: "2 · ticket-pilot — build it" {
  style: {fill: "#F8FAFC"; stroke: "#CBD5E1"; font-color: "#334155"; border-radius: 8}
  triage: "triage the ticket" {class: step}
  impl: "owning agent\n\nimplements on a branch" {class: agent}
  rev: "reviewer\n\nadversarial review" {class: critic}
  risky: "Risky\nchange?" {
    shape: diamond
    style: {fill: "#FCE7F3"; stroke: "#DB2777"; font-color: "#831843"}
  }
  gate: "owner-gate\n\nclears or parks risky changes" {class: critic}
  ci: "CI watch + repair" {class: step}
  ready: "Ready to merge" {class: step}

  triage -> impl
  impl -> rev
  rev -> impl: "rejected,\nmax 2 rounds" {style: {stroke: "#DB2777"; font-color: "#831843"; stroke-dash: 3}}
  rev -> risky: approved
  risky -> ci: no
  risky -> gate: yes
  gate -> ci: cleared
  ci -> impl: "CI fails,\nremediate" {style: {stroke: "#DB2777"; font-color: "#831843"; stroke-dash: 3}}
  ci -> ready: green
}

rejected: "Rejected" {class: bad}
merged: "Merged 🎉" {class: good}

lead: "lead session\n\nmerges the PR" {class: agent}

human -> ip.review: "sends a raw idea 💡"
ip.verdict -> rejected: reject
ip.verdict -> human: "asks one precise question ❓" {style: {stroke: "#D97706"; font-color: "#78350F"; stroke-dash: 3}}
ip.tickets -> tp.triage
tp.gate -> human: "parks with one precise question" {style: {stroke: "#D97706"; font-color: "#78350F"; stroke-dash: 3}}
tp.ready -> human: "asks for merge approval" {style: {stroke: "#D97706"; font-color: "#78350F"; stroke-dash: 3}}
human -> lead: "approves in the chat ✅"
lead -> merged
merged -> human: "next idea 🔁" {style: {stroke: "#16A34A"; font-color: "#14532D"; stroke-dash: 3}}
