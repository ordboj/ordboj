{
  "permissions": {
    "allow": ["mcp__Linear", "Bash(npm run lint)", "Bash(npm run typecheck)", "Bash(npm test)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"$HOME/.local/bin:$PATH\"; if command -v rtk >/dev/null 2>&1; then exec rtk hook claude; fi; exit 0"
          }
        ]
      }
    ]
  }
}
